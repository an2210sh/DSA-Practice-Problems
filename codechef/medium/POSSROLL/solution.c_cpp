#include <iostream>

using namespace std;

int main() {
    // Optimize standard input/output streams for speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int X, K, Y;
    if (cin >> X >> K >> Y) {
        // Check if Y is a multiple of K and the corresponding face is within 1 and X
        if (Y % K == 0) {
            int face = Y / K;
            if (face >= 1 && face <= X) {
                cout << "YES\n";
                return 0;
            }
        }
        cout << "NO\n";
    }

    return 0;
}

